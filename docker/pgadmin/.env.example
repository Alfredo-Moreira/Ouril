# pgAdmin for the production database on Neon (docker/pgadmin/compose.neon.yaml).
# Copy to docker/pgadmin/.env (gitignored) and fill in. Take the host, user and database from
# Neon's Connect dialog with the PRIMARY compute selected (not the read replica). The password
# isn't stored here: pgAdmin asks for it on first connect, and can save it in its volume.

# pgAdmin's own login (this instance can read and change production data).
PGADMIN_DEFAULT_EMAIL=you@example.com
PGADMIN_DEFAULT_PASSWORD=

# Neon connection, from postgresql://<user>:<password>@<host>/<database>?sslmode=require
NEON_HOST=ep-example-123456.eu-central-1.aws.neon.tech
NEON_USER=neondb_owner
NEON_DATABASE=neondb

# Host port for pgAdmin (the local stack's pgAdmin uses 5050).
PGADMIN_NEON_PORT=5051
