# Ouril server configuration (12-factor). Copy to .env for local development (`just env`).
# Never commit .env. In production every secret lives in the `production` GitHub environment and
# is passed to the Vercel deployment by .github/workflows/deploy-web.yml (ADR 0030).

# --- Database ------------------------------------------------------------------------------
# Inside compose the host is `db`. compose.yaml sets this for the server and toolbox; override
# with COMPOSE_DATABASE_URL in your shell if you need another database.
DATABASE_URL=postgres://ouril:ouril@db:5432/ouril
# Connection pool size per server process.
DB_MAX_CONNECTIONS=10

# --- HTTP ----------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
# Comma-separated exact origins allowed for CORS and cookie auth (the web app). Origins match
# exactly, so list every address you open the app at: localhost, 127.0.0.1 and [::1] are the
# same machine but different origins. For LAN/phone testing (docker/compose.lan.yaml), append
# http://<your-ip>:5173.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173
# Optional shared secret an external proxy sends on every /v1 request (ADR 0029). Empty = no
# check. Unused on Vercel, where the server is only reachable through Vercel (ADR 0030).
ORIGIN_SECRET=
# Header carrying the visitor's IP, set by the platform in front of the server (x-real-ip on
# Vercel). Empty = no header is trusted; rate limits use the peer address.
CLIENT_IP_HEADER=
# Per client network (IPv4 address or IPv6 /64) per minute, per server machine. Sign-in only
# for AUTH; refresh, logout and everything else share DEFAULT (apps/server/src/ratelimit.rs).
RATE_LIMIT_AUTH_PER_MINUTE=60
RATE_LIMIT_DEFAULT_PER_MINUTE=600

# --- Sessions ------------------------------------------------------------------------------
# HMAC key for access tokens, at least 32 bytes. DEV-ONLY value below. Production's lives in
# the `production` GitHub environment (JWT_SECRET, e.g. `openssl rand -base64 48`; keep it stable).
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- App versions served by GET /v1/meta (docs/architecture/versioning.md) ----------------
MIN_SUPPORTED_IOS=0.1.0
MIN_SUPPORTED_ANDROID=0.1.0
MIN_SUPPORTED_WEB=0.1.0
RECOMMENDED_IOS=0.1.0
RECOMMENDED_ANDROID=0.1.0
RECOMMENDED_WEB=0.1.0

# --- OAuth placeholders (ADR 0009) ---------------------------------------------------------
# Empty = not configured: POST /v1/auth/google and /v1/auth/apple answer 501 not_configured,
# and the apps show disabled sign-in buttons. Use POST /v1/auth/dev locally instead.
GOOGLE_CLIENT_ID=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Path to the Apple .p8 key inside the container (never commit the key; *.p8 is gitignored).
# It signs the client secret for Apple's code exchange and token revocation (account deletion).
# If the key can't be loaded, Apple sign-in stays off.
APPLE_PRIVATE_KEY_PATH=
# Optional: the iOS app bundle ID (audience of native iOS identity tokens).
APPLE_BUNDLE_ID=
# Optional: the redirect URI registered for the web flow (sent with web code exchanges).
APPLE_REDIRECT_URI=

# --- Telemetry (ADR 0014) ------------------------------------------------------------------
# Empty = telemetry is a no-op.
SENTRY_DSN=
# Web app (Vite build-time variable): empty = crash reports are a no-op even with consent.
VITE_SENTRY_DSN=
# Web app usage statistics: self-hosted Matomo (ADR 0026). Both empty = usage statistics are a
# no-op even with consent. Production builds set them in .github/workflows/deploy-web.yml.
VITE_MATOMO_URL=
VITE_MATOMO_SITE_ID=

# --- Logging -------------------------------------------------------------------------------
RUST_LOG=info,ouril_server=debug,tower_http=info
# `json` for JSON-lines logs (production); anything else is human-readable.
LOG_FORMAT=text

# --- Live-game relay (ADR 0032, 0033) ------------------------------------------------------
# Empty = no relay: live games still work, by polling. To try the relay locally, run
# `just relay` and set (local values only; production's come from the `production`
# GitHub environment and deploy/homelab/.env):
#   RELAY_URL=http://relay:8090
#   RELAY_WS_URL=ws://localhost:8090/ws
#   RELAY_API_KEY=local-relay-api-key-0123456789abcdef
#   RELAY_TOKEN_SECRET=local-relay-token-secret-0123456789ab
RELAY_URL=
RELAY_WS_URL=
RELAY_API_KEY=
RELAY_TOKEN_SECRET=

# --- Unreleased web features (src/features.ts) ----------------------------------------------
# Off for the MVP. "true" turns on sign-in/accounts/sync, and the Stats page. compose.yaml passes
# these to the web container.
VITE_FEATURE_ACCOUNTS=false
VITE_FEATURE_STATS=false
# Google sign-in on the web (public client ID): the same value as GOOGLE_CLIENT_ID above.
# Empty = the button is a disabled placeholder. See docs/product/features/accounts.md.
VITE_GOOGLE_CLIENT_ID=
