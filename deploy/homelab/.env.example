# Ouril's homelab services (ADR 0032, docs/architecture/deployment.md#the-homelab).
# Copy to deploy/homelab/.env (gitignored) and fill it in. build-and-push.sh bakes each
# service's own keys into its image, as the home-lab repo does, so the NAS needs only the
# compose file.
# Never commit the real file, and never push the image to a public registry.

# The private registry the script pushes to: host:port (plain HTTP on the LAN).
REGISTRY=

# Shared with the server: the same values as RELAY_API_KEY and RELAY_TOKEN_SECRET in the
# `production` GitHub environment. Generate each with `openssl rand -hex 32`; they must differ.
RELAY_API_KEY=
RELAY_TOKEN_SECRET=

# Web app origins allowed to open a WebSocket, comma-separated.
ALLOWED_ORIGINS=https://ouril.vercel.app

# Optional limits (defaults shown).
# MAX_CONNECTIONS=2000
# MAX_CONNECTIONS_PER_IP=20
# UPGRADES_PER_MINUTE_PER_IP=30

# --- ouril-jobs (scheduled jobs) ---
# The server it calls, and the token for POST /v1/internal/jobs/*: the same value as JOBS_TOKEN
# in the `production` GitHub environment. `openssl rand -hex 32`; different from the others.
JOBS_URL=https://ouril.vercel.app
JOBS_TOKEN=
# Optional (defaults shown).
# JOBS_INTERVAL_SECS=3600
# JOBS_LIST=leaderboard-snapshot,prune

